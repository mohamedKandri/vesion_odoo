<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.startup.base</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <block title="Branding" name="startup_branding_setting_container">
                    <setting id="startup_branding_setting" string="Branding" help="Customize your brand colors and tagline">
                        <field name="primary_color"/>
                        <field name="secondary_color"/>
                        <field name="tagline"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
